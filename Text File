<html lang="en"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wound Healing Progress Tracker</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        .main-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
        }

        .card h2 {
            color: #4a5568;
            margin-bottom: 20px;
            font-size: 1.4rem;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 10px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #4a5568;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            margin-right: 10px;
            margin-bottom: 10px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        }

        .btn-danger {
            background: linear-gradient(135deg, #f56565 0%, #e53e3e 100%);
        }

        .progress-tracker {
            grid-column: 1 / -1;
        }

        .progress-entries {
            margin-top: 20px;
        }

        .progress-entry {
            background: #f7fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            position: relative;
        }

        .entry-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 10px;
        }

        .entry-date {
            font-weight: 600;
            color: #667eea;
        }

        .delete-entry {
            background: #e53e3e;
            color: white;
            border: none;
            border-radius: 50%;
            width: 25px;
            height: 25px;
            cursor: pointer;
            font-size: 12px;
        }

        .wound-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 10px;
            margin-bottom: 10px;
        }

        .wound-detail {
            background: white;
            padding: 10px;
            border-radius: 6px;
            border-left: 4px solid #667eea;
        }

        .wound-detail strong {
            color: #4a5568;
        }

        .photo-preview {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        .photo-item {
            position: relative;
            width: 100px;
            height: 100px;
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid #e2e8f0;
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .report-section {
            grid-column: 1 / -1;
            background: linear-gradient(135deg, #ffffff 0%, #f7fafc 100%);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            border: 1px solid #e2e8f0;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: #667eea;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #4a5568;
            font-size: 0.9rem;
        }

        .healing-chart {
            background: white;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            margin-top: 20px;
        }

        .chart-placeholder {
            height: 200px;
            background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4a5568;
            font-style: italic;
        }

        .alert {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 4px solid;
        }

        .alert-success {
            background-color: #f0fff4;
            border-color: #48bb78;
            color: #2f855a;
        }

        .alert-warning {
            background-color: #fffbeb;
            border-color: #ed8936;
            color: #c05621;
        }

        @media (max-width: 768px) {
            .main-content {
                grid-template-columns: 1fr;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .header h1 {
                font-size: 2rem;
            }
        }

        .hidden {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🩹 Wound Healing Tracker</h1>
            <p>Monitor and track your wound healing progress over time</p>
        </div>

        <div class="main-content">
            <!-- Wound Information Form -->
            <div class="card">
                <h2>Wound Information</h2>
                <form id="woundForm">
                    <div class="form-group">
                        <label for="woundLocation">Wound Location</label>
                        <input type="text" id="woundLocation" placeholder="e.g., Left knee, Right hand" required="">
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="woundType">Wound Type</label>
                            <select id="woundType" required="">
                                <option value="">Select Type</option>
                                <option value="surgical">Surgical</option>
                                <option value="laceration">Laceration</option>
                                <option value="burn">Burn</option>
                                <option value="ulcer">Ulcer</option>
                                <option value="abrasion">Abrasion</option>
                                <option value="puncture">Puncture</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="injuryDate">Injury Date</label>
                            <input type="date" id="injuryDate" required="">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="woundLength">Length (cm)</label>
                            <input type="number" id="woundLength" step="0.1" min="0" placeholder="0.0">
                        </div>
                        
                        <div class="form-group">
                            <label for="woundWidth">Width (cm)</label>
                            <input type="number" id="woundWidth" step="0.1" min="0" placeholder="0.0">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="initialNotes">Initial Notes</label>
                        <textarea id="initialNotes" rows="3" placeholder="Describe the initial condition of the wound..."></textarea>
                    </div>
                </form>
            </div>

            <!-- Progress Entry Form -->
            <div class="card">
                <h2>Add Progress Entry</h2>
                <form id="progressForm">
                    <div class="form-group">
                        <label for="entryDate">Date</label>
                        <input type="date" id="entryDate" required="">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="currentLength">Current Length (cm)</label>
                            <input type="number" id="currentLength" step="0.1" min="0" placeholder="0.0">
                        </div>
                        
                        <div class="form-group">
                            <label for="currentWidth">Current Width (cm)</label>
                            <input type="number" id="currentWidth" step="0.1" min="0" placeholder="0.0">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="healingStage">Healing Stage</label>
                        <select id="healingStage" required="">
                            <option value="">Select Stage</option>
                            <option value="hemostasis">Hemostasis</option>
                            <option value="inflammation">Inflammation</option>
                            <option value="proliferation">Proliferation</option>
                            <option value="maturation">Maturation/Remodeling</option>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="painLevel">Pain Level (1-10)</label>
                            <input type="range" id="painLevel" min="1" max="10" value="1">
                            <span id="painValue">1</span>
                        </div>
                        
                        <div class="form-group">
                            <label for="drainage">Drainage</label>
                            <select id="drainage">
                                <option value="none">None</option>
                                <option value="minimal">Minimal</option>
                                <option value="moderate">Moderate</option>
                                <option value="heavy">Heavy</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="woundPhotos">Upload Photos</label>
                        <input type="file" id="woundPhotos" accept="image/*" multiple="">
                    </div>

                    <div class="form-group">
                        <label for="progressNotes">Progress Notes</label>
                        <textarea id="progressNotes" rows="3" placeholder="Describe current condition, treatment applied, etc..."></textarea>
                    </div>

                    <button type="submit" class="btn">Add Progress Entry</button>
                </form>
            </div>

            <!-- Progress Tracker Display -->
            <div class="card progress-tracker">
                <h2>Healing Progress Timeline</h2>
                <div id="alertContainer"></div>
                
                <div class="progress-entries" id="progressEntries"><p style="text-align: center; color: #666; font-style: italic;">No progress entries yet. Add your first entry above!</p></div>
                
                <div class="healing-chart">
                    <h3>Wound Size Over Time</h3>
                    <canvas id="healingChart" width="400" height="200"></canvas>
                </div>
            </div>

            <!-- Reports and Statistics -->
            <div class="card report-section">
                <h2>Healing Statistics &amp; Reports</h2>
                
                <div class="stats-grid" id="statsGrid">
                    <div class="stat-card">
                        <div class="stat-number" id="daysSinceInjury">0</div>
                        <div class="stat-label">Days Since Injury</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="totalEntries">0</div>
                        <div class="stat-label">Progress Entries</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="sizeReduction">0%</div>
                        <div class="stat-label">Size Reduction</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="avgPainLevel">-</div>
                        <div class="stat-label">Avg Pain Level</div>
                    </div>
                </div>

                <button class="btn btn-secondary" onclick="generateReport()">Generate Full Report</button>
                <button class="btn btn-secondary" onclick="exportData()">Export Data</button>
                <button class="btn btn-danger" onclick="clearAllData()">Clear All Data</button>
            </div>
        </div>
    </div>

    <script>
        // Global variables
        let woundData = JSON.parse(localStorage.getItem('woundData')) || {};
        let progressEntries = JSON.parse(localStorage.getItem('progressEntries')) || [];

        // Initialize the application
        document.addEventListener('DOMContentLoaded', function() {
            // Set today's date as default
            document.getElementById('entryDate').valueAsDate = new Date();
            
            // Pain level slider
            const painSlider = document.getElementById('painLevel');
            const painValue = document.getElementById('painValue');
            painSlider.addEventListener('input', function() {
                painValue.textContent = this.value;
            });

            // Form submissions
            document.getElementById('woundForm').addEventListener('submit', handleWoundForm);
            document.getElementById('progressForm').addEventListener('submit', handleProgressForm);

            // Load existing data
            loadWoundData();
            displayProgressEntries();
            updateStatistics();
            drawChart();
        });

        // Handle wound information form
        function handleWoundForm(e) {
            e.preventDefault();
            
            woundData = {
                location: document.getElementById('woundLocation').value,
                type: document.getElementById('woundType').value,
                injuryDate: document.getElementById('injuryDate').value,
                initialLength: parseFloat(document.getElementById('woundLength').value) || 0,
                initialWidth: parseFloat(document.getElementById('woundWidth').value) || 0,
                initialNotes: document.getElementById('initialNotes').value
            };

            localStorage.setItem('woundData', JSON.stringify(woundData));
            showAlert('Wound information saved successfully!', 'success');
            updateStatistics();
        }

        // Handle progress form
        function handleProgressForm(e) {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const photos = document.getElementById('woundPhotos').files;
            const photoUrls = [];

            // Convert photos to base64 for storage (simplified for demo)
            Array.from(photos).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    photoUrls.push(e.target.result);
                };
                reader.readAsDataURL(file);
            });

            const entry = {
                id: Date.now(),
                date: document.getElementById('entryDate').value,
                length: parseFloat(document.getElementById('currentLength').value) || 0,
                width: parseFloat(document.getElementById('currentWidth').value) || 0,
                healingStage: document.getElementById('healingStage').value,
                painLevel: parseInt(document.getElementById('painLevel').value),
                drainage: document.getElementById('drainage').value,
                notes: document.getElementById('progressNotes').value,
                photos: photoUrls
            };

            progressEntries.push(entry);
            progressEntries.sort((a, b) => new Date(a.date) - new Date(b.date));
            
            localStorage.setItem('progressEntries', JSON.stringify(progressEntries));
            
            // Reset form
            document.getElementById('progressForm').reset();
            document.getElementById('entryDate').valueAsDate = new Date();
            document.getElementById('painValue').textContent = '1';
            
            displayProgressEntries();
            updateStatistics();
            drawChart();
            showAlert('Progress entry added successfully!', 'success');
        }

        // Load wound data into form
        function loadWoundData() {
            if (Object.keys(woundData).length > 0) {
                document.getElementById('woundLocation').value = woundData.location || '';
                document.getElementById('woundType').value = woundData.type || '';
                document.getElementById('injuryDate').value = woundData.injuryDate || '';
                document.getElementById('woundLength').value = woundData.initialLength || '';
                document.getElementById('woundWidth').value = woundData.initialWidth || '';
                document.getElementById('initialNotes').value = woundData.initialNotes || '';
            }
        }

        // Display progress entries
        function displayProgressEntries() {
            const container = document.getElementById('progressEntries');
            container.innerHTML = '';

            if (progressEntries.length === 0) {
                container.innerHTML = '<p style="text-align: center; color: #666; font-style: italic;">No progress entries yet. Add your first entry above!</p>';
                return;
            }

            progressEntries.forEach(entry => {
                const entryDiv = document.createElement('div');
                entryDiv.className = 'progress-entry';
                
                entryDiv.innerHTML = `
                    <div class="entry-header">
                        <span class="entry-date">${formatDate(entry.date)}</span>
                        <button class="delete-entry" onclick="deleteEntry(${entry.id})" title="Delete Entry">×</button>
                    </div>
                    <div class="wound-info">
                        <div class="wound-detail">
                            <strong>Size:</strong> ${entry.length} × ${entry.width} cm
                        </div>
                        <div class="wound-detail">
                            <strong>Stage:</strong> ${capitalizeFirst(entry.healingStage)}
                        </div>
                        <div class="wound-detail">
                            <strong>Pain:</strong> ${entry.painLevel}/10
                        </div>
                        <div class="wound-detail">
                            <strong>Drainage:</strong> ${capitalizeFirst(entry.drainage)}
                        </div>
                    </div>
                    ${entry.notes ? <p><strong>Notes:</strong> ${entry.notes}</p> : ''}
                    ${entry.photos && entry.photos.length > 0 ? `
                        <div class="photo-preview">
                            ${entry.photos.map(photo => <div class="photo-item"><img src="${photo}" alt="Wound photo"></div>).join('')}
                        </div>
                    ` : ''}
                `;
                
                container.appendChild(entryDiv);
            });
        }

        // Delete progress entry
        function deleteEntry(entryId) {
            if (confirm('Are you sure you want to delete this progress entry?')) {
                progressEntries = progressEntries.filter(entry => entry.id !== entryId);
                localStorage.setItem('progressEntries', JSON.stringify(progressEntries));
                displayProgressEntries();
                updateStatistics();
                drawChart();
                showAlert('Progress entry deleted.', 'warning');
            }
        }

        // Update statistics
        function updateStatistics() {
            const daysSince = woundData.injuryDate ? 
                Math.floor((new Date() - new Date(woundData.injuryDate)) / (1000 * 60 * 60 * 24)) : 0;
            
            const totalEntries = progressEntries.length;
            
            let sizeReduction = 0;
            if (woundData.initialLength && woundData.initialWidth && progressEntries.length > 0) {
                const initialArea = woundData.initialLength * woundData.initialWidth;
                const latestEntry = progressEntries[progressEntries.length - 1];
                const currentArea = latestEntry.length * latestEntry.width;
                sizeReduction = Math.round(((initialArea - currentArea) / initialArea) * 100);
            }
            
            const avgPain = progressEntries.length > 0 ? 
                Math.round(progressEntries.reduce((sum, entry) => sum + entry.painLevel, 0) / progressEntries.length) : 0;

            document.getElementById('daysSinceInjury').textContent = daysSince;
            document.getElementById('totalEntries').textContent = totalEntries;
            document.getElementById('sizeReduction').textContent = sizeReduction + '%';
            document.getElementById('avgPainLevel').textContent = avgPain || '-';
        }

        // Draw healing chart
        function drawChart() {
            const canvas = document.getElementById('healingChart');
            const ctx = canvas.getContext('2d');
            
            // Clear canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            if (progressEntries.length < 2) {
                ctx.fillStyle = '#666';
                ctx.font = '16px Arial';
                ctx.textAlign = 'center';
                ctx.fillText('Add more entries to see healing progress chart', canvas.width/2, canvas.height/2);
                return;
            }

            // Simple line chart implementation
            const margin = 40;
            const width = canvas.width - 2 * margin;
            const height = canvas.height - 2 * margin;
            
            // Calculate wound areas
            const areas = progressEntries.map(entry => entry.length * entry.width);
            const maxArea = Math.max(...areas);
            const minArea = Math.min(...areas);
            
            // Draw axes
            ctx.strokeStyle = '#333';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(margin, margin);
            ctx.lineTo(margin, height + margin);
            ctx.lineTo(width + margin, height + margin);
            ctx.stroke();
            
            // Draw data points and line
            ctx.strokeStyle = '#667eea';
            ctx.fillStyle = '#667eea';
            ctx.lineWidth = 3;
            ctx.beginPath();
            
            for (let i = 0; i < areas.length; i++) {
                const x = margin + (i / (areas.length - 1)) * width;
                const y = margin + height - ((areas[i] - minArea) / (maxArea - minArea)) * height;
                
                if (i === 0) {
                    ctx.moveTo(x, y);
                } else {
                    ctx.lineTo(x, y);
                }
                
                // Draw point
                ctx.fillRect(x - 3, y - 3, 6, 6);
            }
            
            ctx.stroke();
            
            // Labels
            ctx.fillStyle = '#333';
            ctx.font = '12px Arial';
            ctx.textAlign = 'center';
            ctx.fillText('Time →', width/2 + margin, height + margin + 30);
            
            ctx.save();
            ctx.translate(15, height/2 + margin);
            ctx.rotate(-Math.PI/2);
            ctx.fillText('← Wound Area (cm²)', 0, 0);
            ctx.restore();
        }

        // Show alert messages
        function showAlert(message, type = 'success') {
            const alertContainer = document.getElementById('alertContainer');
            const alert = document.createElement('div');
            alert.className = alert alert-${type};
            alert.textContent = message;
            
            alertContainer.appendChild(alert);
            
            setTimeout(() => {
                alert.remove();
            }, 3000);
        }

        // Generate comprehensive report
        function generateReport() {
            if (Object.keys(woundData).length === 0) {
                showAlert('Please fill in wound information first.', 'warning');
                return;
            }
            
            let report = WOUND HEALING PROGRESS REPORT\n;
            report += Generated on: ${new Date().toLocaleDateString()}\n\n;
            report += WOUND INFORMATION:\n;
            report += Location: ${woundData.location}\n;
            report += Type: ${woundData.type}\n;
            report += Injury Date: ${woundData.injuryDate}\n;
            report += Initial Size: ${woundData.initialLength} × ${woundData.initialWidth} cm\n\n;
            
            if (progressEntries.length > 0) {
                report += PROGRESS SUMMARY:\n;
                report += Total Entries: ${progressEntries.length}\n;
                report += Days Since Injury: ${Math.floor((new Date() - new Date(woundData.injuryDate)) / (1000 * 60 * 60 * 24))}\n\n;
                
                report += DETAILED PROGRESS:\n;
                progressEntries.forEach((entry, index) => {
                    report += ${index + 1}. ${formatDate(entry.date)}\n;
                    report += `   Size: ${entry.length} × ${entry.width} cm\n`;
                    report += `   Stage: ${entry.healingStage}\n`;
                    report += `   Pain: ${entry.painLevel}/10\n`;
                    report += `   Drainage: ${entry.drainage}\n`;
                    if (entry.notes) report += `   Notes: ${entry.notes}\n`;
                    report += \n;
                });
            }
            
            // Create downloadable file
            const blob = new Blob([report], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = wound_healing_report_${new Date().toISOString().split('T')[0]}.txt;
            a.click();
            URL.revokeObjectURL(url);
        }

        // Export data as JSON
        function exportData() {
            const data = {
                woundData: woundData,
                progressEntries: progressEntries,
                exportDate: new Date().toISOString()
            };
            
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = wound_tracker_data_${new Date().toISOString().split('T')[0]}.json;
            a.click();
            URL.revokeObjectURL(url);
        }

        // Clear all data
        function clearAllData() {
            if (confirm('Are you sure you want to clear ALL wound tracking data? This cannot be undone.')) {
                localStorage.removeItem('woundData');
                localStorage.removeItem('progressEntries');
                woundData = {};
                progressEntries = [];
                
                // Reset forms
                document.getElementById('woundForm').reset();
                document.getElementById('progressForm').reset();
                document.getElementById('entryDate').valueAsDate = new Date();
                document.getElementById('painValue').textContent = '1';
                
                displayProgressEntries();
                updateStatistics();
                drawChart();
                showAlert('All data cleared successfully.', 'warning');
            }
        }

        // Utility functions
        function formatDate(dateString) {
            return new Date(dateString).toLocaleDateString('en-US', { 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric' 
            });
        }

        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }
    </script>

